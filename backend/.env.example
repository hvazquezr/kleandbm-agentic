# Copy to backend/.env and fill in. Never commit .env.
KLEANDBM_DATABASE_URL=postgresql+psycopg://kleandbm:kleandbm@localhost:5432/kleandbm

# Auth0 development tenant (API audience = the API identifier configured in Auth0)
KLEANDBM_AUTH_ISSUER=https://YOUR-TENANT.us.auth0.com/
KLEANDBM_AUTH_AUDIENCE=https://api.kleandbm.local
# Optional: token permissions every call must carry, as a JSON list
# KLEANDBM_AUTH_REQUIRED_PERMISSIONS=["kleandbm:use"]

# Used only by pytest; its schema is dropped and rebuilt on every run
KLEANDBM_TEST_DATABASE_URL=postgresql+psycopg://kleandbm:kleandbm@localhost:5432/kleandbm_test

# Document storage: "local" (files under KLEANDBM_LOCAL_STORAGE_DIR) or "s3"
KLEANDBM_STORAGE_BACKEND=local
KLEANDBM_LOCAL_STORAGE_DIR=../var/objects
# For S3, credentials come from the standard AWS chain (env vars, ~/.aws profile, instance role)
# KLEANDBM_STORAGE_BACKEND=s3
# KLEANDBM_S3_BUCKET=your-bucket
# KLEANDBM_S3_PREFIX=kleandbm/
# KLEANDBM_S3_REGION=us-east-1

# Embeddings for document search: "fake" (offline, not semantic) or "openai"
KLEANDBM_EMBEDDING_PROVIDER=fake
# KLEANDBM_EMBEDDING_PROVIDER=openai
# KLEANDBM_OPENAI_API_KEY=sk-...
# KLEANDBM_EMBEDDING_MODEL=text-embedding-3-small

# Encrypts stored secrets such as source passwords (a Fernet key). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KLEANDBM_SECRETS_KEY=
# Hosts a source connection may use (JSON list). Keep this tight: connections make the backend
# open network connections.
# KLEANDBM_SOURCE_ALLOWED_HOSTS=["127.0.0.1","localhost"]

# Written by eval/northstar/load.sh: the Northstar sample source's read-only password
# KLEANDBM_DEV_NORTHSTAR_PASSWORD=

# Agents. The Business Requirements agent uses Claude through the Anthropic API.
KLEANDBM_ANTHROPIC_API_KEY=
# KLEANDBM_REQUIREMENTS_AGENT_MODEL=claude-opus-5-5
# KLEANDBM_REQUIREMENTS_AGENT_EFFORT=high
# KLEANDBM_AGENT_MAX_ITERATIONS=14
# KLEANDBM_ARCHITECT_AGENT_MODEL=claude-opus-5-5
# KLEANDBM_ARCHITECT_AGENT_EFFORT=high
# KLEANDBM_ARCHITECT_MAX_ITERATIONS=40
# ask_requirements: Business Requirements consultations per Architect run, and model calls each
# KLEANDBM_ARCHITECT_MAX_CONSULTATIONS=3
# KLEANDBM_CONSULTATION_MAX_ITERATIONS=8
# Validator: a different model family than the Architect. openai | anthropic (interim:
# claude-sonnet-5-5) | none (skip review; the model stays Draft, unverified). Uses
# KLEANDBM_OPENAI_API_KEY for openai.
# KLEANDBM_VALIDATOR_AGENT_PROVIDER=openai
# KLEANDBM_VALIDATOR_AGENT_MODEL=gpt-6-astra
# KLEANDBM_VALIDATOR_AGENT_EFFORT=high
# KLEANDBM_VALIDATOR_MAX_ITERATIONS=16
# KLEANDBM_VALIDATOR_MAX_ROUNDS=3
# KLEANDBM_VALIDATOR_MAX_ATTEMPTS_PER_ISSUE=3
# Selective Tree of Thought at Architect decision points (false = single-candidate baseline).
# KLEANDBM_ARCHITECT_TOT_ENABLED=true
# KLEANDBM_ARCHITECT_MAX_DECISION_POINTS=2
# KLEANDBM_TOT_CHILDREN=3
# KLEANDBM_TOT_BEAM=2
# KLEANDBM_TOT_SCORE_THRESHOLD=2.5
# KLEANDBM_TOT_MAX_MODEL_CALLS=14
# KLEANDBM_TOT_MAX_TOOL_CALLS=24
# KLEANDBM_TOT_MAX_SECONDS=900
# KLEANDBM_TOT_MAX_OUTPUT_TOKENS=80000

# Reading images at upload (table captures, dashboards): anthropic | fake | none
# KLEANDBM_IMAGE_DESCRIPTION_PROVIDER=anthropic
# KLEANDBM_IMAGE_DESCRIPTION_MODEL=claude-opus-5-5

# LangSmith tracing (app/adapters/tracing.py), off by default. "metadata" sends only structure,
# timing, ids, models, token usage and tool names; "full" adds prompts and tool data (credentials
# redacted, personal data masked) and is for synthetic eval data only. Don't set the global
# LANGSMITH_* variables: they're ignored.
# KLEANDBM_LANGSMITH_TRACING=true
# KLEANDBM_LANGSMITH_API_KEY=lsv2_...
# KLEANDBM_LANGSMITH_PROJECT=kleandbm   # one project per environment, e.g. kleandbm-ai-local, -development, -staging, -production
# KLEANDBM_LANGSMITH_CONTENT=metadata

# Transcript monitor (app/agents/monitor): reads each finished run on another model family than
# the Architect and stores a suspicion score. Uses KLEANDBM_OPENAI_API_KEY for openai; without a
# model the assessment is recorded as skipped.
# KLEANDBM_MONITOR_ENABLED=true
# KLEANDBM_MONITOR_AGENT_PROVIDER=openai
# KLEANDBM_MONITOR_AGENT_MODEL=gpt-6-astra
# KLEANDBM_MONITOR_AGENT_EFFORT=medium
# KLEANDBM_MONITOR_SAMPLES=1
# KLEANDBM_MONITOR_FLAG_THRESHOLD=50

# The request router for Assistant conversations: one small model call per message picks the
# agent. Any provider; it never reads documents, sources or agent replies.
# KLEANDBM_ROUTER_AGENT_PROVIDER=anthropic
# KLEANDBM_ROUTER_AGENT_MODEL=claude-haiku-5-5
# KLEANDBM_ROUTER_AGENT_EFFORT=low
# Describe with AI in the New table form: one small model call; it writes nothing.
# KLEANDBM_TABLE_SUGGESTION_AGENT_PROVIDER=anthropic
# KLEANDBM_TABLE_SUGGESTION_AGENT_MODEL=claude-haiku-5-5
# KLEANDBM_TABLE_SUGGESTION_AGENT_EFFORT=low
