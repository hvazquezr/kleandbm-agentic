# Copy to frontend/.env.local. These values are public (they ship to the browser), but
# keep .env.local out of git anyway so each developer can point at their own Auth0 tenant.
VITE_AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Must equal the backend's KLEANDBM_AUTH_AUDIENCE (the Auth0 API identifier)
VITE_AUTH0_AUDIENCE=https://api.kleandbm.local

# Where Vite proxies /api in development (the FastAPI dev server)
API_PROXY_TARGET=http://localhost:8001
